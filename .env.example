# Copie este arquivo para .env e preencha conforme o provedor escolhido.
# Detalhes de cada opção no README (seção "Configuração").

# Provedor do modelo: anthropic | groq | ollama
LLM_PROVIDER=anthropic

# Chave de API do provedor escolhido (não necessária para ollama)
LLM_API_KEY=

# Modelo a utilizar (deixe vazio para usar o padrão do provedor)
LLM_MODEL=
